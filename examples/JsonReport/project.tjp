project json_example "JSON Export Example" 2025-01-01 +3m {
  timezone "UTC"
  currency "USD"
  currencyformat "(" ")" "," "." 2
  now 2025-01-23
  
  # Define project-wide working hours
  workinghours mon - fri 9:00 - 12:00, 13:00 - 17:00
  workinghours sat, sun off
}

# Define resources
resource dev1 "Alice Smith" {
  email "alice@example.com"
  rate 75.0
}
resource dev2 "Bob Jones" {
  email "bob@example.com" 
  rate 65.0
}

# Define cost accounts
account dev_costs "Development Costs"

# Define tasks
task project "Web Application" {
  start ${projectstart}
  
  task design "Design Phase" {
    effort 5d
    allocate dev1
    complete 100
  }
  
  task development "Development" {
    depends !design
    
    task backend "Backend Development" {
      effort 10d
      allocate dev2
      complete 50
      chargeset dev_costs
      charge 6500 onend
    }
    
    task frontend "Frontend Development" {
      effort 15d
      allocate dev1
      depends !backend
      chargeset dev_costs
      charge 11250 onend
    }
  }
  
  task testing "Testing Phase" {
    depends !development
    effort 8d
    allocate dev1, dev2
  }
}

# Generate traditional HTML report
taskreport html "TaskReport" {
  formats html
  columns bsi, name, start, end, effort, cost, chart { scale day }
}

# Generate comprehensive JSON export
jsonreport json_export "project_data.json" {
  formats json
  scenarios plan
}