project test_gantt "Test Gantt Chart" 2025-01-01 +3m {
  timezone "America/New_York"
  currency "USD"
}

# Resources
resource dev "Developer" {
  efficiency 1.0
  rate 100.0
}

resource qa "QA Engineer" {
  efficiency 1.0
  rate 80.0
}

# Tasks
task project "Web Application" {
  
  task design "Design Phase" {
    effort 40h
    allocate dev
  }
  
  task development "Development" {
    depends !design
    
    task backend "Backend Development" {
      effort 80h
      allocate dev
    }
    
    task frontend "Frontend Development" {
      depends !backend
      effort 60h
      allocate dev
    }
  }
  
  task testing "Testing Phase" {
    depends !development
    effort 40h
    allocate qa
  }
  
  task deployment "Deployment" {
    depends !testing
    effort 8h
    allocate dev
  }
}

# Reports
taskreport gantt_test "Test Gantt Report" {
  formats html, json
  columns name, chart { scale day }
  start 2025-01-01
  end 2025-04-01
  scenarios plan
}