project negative_charges "Negative Charges Test" "1.0" 2025-01-01-00:00-+0000 - 2025-01-31-10:00-+0000 {
  timezone "Europe/Berlin"
  scenario plan "Plan Scenario" {
    active yes
  }
}

projectids negative_charges

resource developer "Developer"
