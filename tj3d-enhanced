#!/bin/bash
# TaskJuggler Enhanced Daemon - Wrapper script for tj3d
# Usage: tj3d-enhanced [options]

# Get the directory where this script is located (resolving symlinks)
SCRIPT_DIR="$(dirname "$(readlink -f "$0")")"

# Setup Ruby environment for user-installed gems
export GEM_HOME="$HOME/.gem/ruby/3.4.0"
export GEM_PATH="$GEM_HOME:/snap/ruby/current/lib/ruby/gems/3.4.0"

# Add all gem lib directories to RUBYLIB
export RUBYLIB=""
for gemdir in "$GEM_HOME/gems/"*/lib; do
    RUBYLIB="$gemdir:$RUBYLIB"
done
export RUBYLIB="$SCRIPT_DIR/lib:$RUBYLIB"

# Execute TaskJuggler daemon
exec ruby "$SCRIPT_DIR/bin/tj3d" "$@"